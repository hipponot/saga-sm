{
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "outputs": [
                ".next/**",
                "dist/**",
                "out/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["build", "db:generate", "db:migrate"],
            "inputs": ["$TURBO_DEFAULT$", "src/**/*.test.*", "src/**/*.spec.*"]
        },
        "lint": {
            "inputs": [
                "$TURBO_DEFAULT$"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$"
            ]
        },
        "clean": {
            "cache": false
        },
        "check": {
            "dependsOn": ["build", "test", "lint", "typecheck"]
        },
        "db:generate": {
            "cache": false
        },
        "db:migrate": {
            "cache": false,
            "inputs": ["packages/database/prisma/schema.prisma"],
            "dependsOn": ["db:generate"]
        },
        "db:deploy": {
            "cache": false
        }
    }
}
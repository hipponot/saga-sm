{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug saga-sm/apps/api",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/dist/main.js",
      "cwd": "${workspaceFolder}/apps/api",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "sourceMaps": true,
      "smartStep": false,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMapPathOverrides": {},
      "outFiles": [
        "${workspaceFolder}/apps/api/dist/**/*.js",
        "${workspaceFolder}/apps/api/node_modules/@hipponot/*/dist/**/*.js"
      ],
      "preLaunchTask": "build-api",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/../saga-soa/**",
        "${workspaceFolder}/apps/api/node_modules/@hipponot/**"
      ]
    }
  ]
}
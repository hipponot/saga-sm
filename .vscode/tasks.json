{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-saga-soa-deps",
            "type": "shell",
            "command": "pnpm",
            "args": ["build"],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/../saga-soa"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "build-api",
            "type": "shell",
            "command": "pnpm",
            "args": ["build"],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/apps/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOn": "build-saga-soa-deps"
        },
        {
            "label": "build-web-client",
            "type": "shell",
            "command": "pnpm",
            "args": ["build"],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/apps/web-client"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "build-api-types",
            "type": "shell",
            "command": "pnpm",

            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "generate-types",
            "type": "shell",
            "command": "pnpm",
            "args": ["generate"],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/apps/api/api-types"
            },
            "presentation": {
                "echo": true,

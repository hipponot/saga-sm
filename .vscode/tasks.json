{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "dependsOrder": "sequence",
      "dependsOn": ["build-saga-soa-packages"],
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "build"],
      "group": "build",
      "cwd": "${workspaceFolder}/apps/api",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-saga-soa-packages",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "build"],
      "group": "build",
      "cwd": "${workspaceFolder}/../saga-soa",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-all",
      "dependsOrder": "sequence",
      "dependsOn": ["build-saga-soa-packages", "build-api"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
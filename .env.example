# GitHub Packages Authentication
# Required for building with published @hipponot packages
GITHUB_TOKEN=your_github_token_here

# Database Configuration
# For local development (using docker-compose services)
MONGODB_URI=mongodb://admin:password123@localhost:27017/saga_sm?authSource=admin
DATABASE_URL=postgresql://saga_user:password123@localhost:5432/saga_sm

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
NODE_ENV=development
LOG_LEVEL=info

# API Service
PORT=3000
PUBSUB_PORT=3002

# Web Client
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_TRPC_URL=http://localhost:3000/trpc
{
    "name": "@saga-sm/api",
    "version": "1.0.0",
    "description": "Schedule management tRPC API service",
    "type": "module",
    "main": "dist/main.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "start": "node dist/main.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "clean": "rm -rf dist",
        "check": "pnpm run build && pnpm run test && pnpm run lint && pnpm run typecheck",
        "lint": "prettier --check .",
        "lint:fix": "prettier --write .",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@saga-soa/api-core": "workspace:*",
        "@saga-soa/db": "workspace:*",
        "@saga-soa/logger": "workspace:*",
        "@saga-soa/pubsub-core": "workspace:*",
        "@saga-soa/config": "workspace:*",
        "inversify": "^6.0.2",
        "reflect-metadata": "^0.2.2",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^18.19.31",
        "tsup": "^8.0.2",
        "typescript": "^5.8.2",
        "vitest": "^1.6.0",
        "prettier": "^3.2.5"
    },
    "engines": {
        "node": ">=18"
    },
    "private": true
}
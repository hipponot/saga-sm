# Dockerfile for local development with saga-soa file: dependencies
# Build context should be run from the dev directory (parent of saga-sm and saga-soa)
# Usage: docker build -f saga-sm/apps/api/Dockerfile.local -t saga-sm-api:local .

# Dependencies stage - for better layer caching
FROM node:20-alpine AS dependencies

WORKDIR /app

# Install pnpm (matching the version used in the project)
RUN npm install -g pnpm@8.15.4

# Copy saga-soa packages first (external dependencies)
COPY saga-soa/ ./saga-soa/

# Copy saga-sm workspace configuration
COPY saga-sm/pnpm-workspace.yaml saga-sm/package.json saga-sm/pnpm-lock.yaml saga-sm/turbo.json ./saga-sm/

# Copy all saga-sm package.json files for dependency resolution
COPY saga-sm/apps/api/package.json ./saga-sm/apps/api/
COPY saga-sm/packages/ ./saga-sm/packages/

# Install dependencies (file: references will work because saga-soa is copied)
WORKDIR /app/saga-sm
RUN pnpm install --no-frozen-lockfile

# Build saga-soa packages first
WORKDIR /app/saga-soa
RUN pnpm build

# Build stage
FROM dependencies AS builder

WORKDIR /app/saga-sm

# Copy saga-sm source code only after dependencies are installed
COPY saga-sm/apps/api/src/ ./apps/api/src/
COPY saga-sm/apps/api/tsconfig.json saga-sm/apps/api/tsup.config.ts ./apps/api/
# Copy database sources and schema
COPY saga-sm/packages/database/src/ ./packages/database/src/
COPY saga-sm/packages/database/prisma/ ./packages/database/prisma/
# Copy api-types package sources
COPY saga-sm/packages/api-types/src/ ./packages/api-types/src/
COPY saga-sm/packages/api-types/tsconfig.json saga-sm/packages/api-types/tsup.config.ts saga-sm/packages/api-types/codegen.config.js ./packages/api-types/

# Generate Prisma client and build with turbo
RUN cd packages/database && npx prisma generate && cd ../.. && \
    npx turbo build --filter=@saga-sm/api

# Production stage - smaller base image
FROM node:20-alpine AS production

WORKDIR /app

# Install only curl for health checks
RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S apiuser -u 1001 -G nodejs

# Install pnpm
RUN npm install -g pnpm@8.15.4

# Copy saga-soa packages and built artifacts
COPY --from=builder /app/saga-soa/ ./saga-soa/

# Copy saga-sm workspace files for production install
COPY --from=builder /app/saga-sm/pnpm-workspace.yaml /app/saga-sm/package.json ./saga-sm/
COPY --from=builder /app/saga-sm/packages/ ./saga-sm/packages/
COPY --from=builder /app/saga-sm/apps/api/package.json ./saga-sm/apps/api/

# Install production dependencies only
WORKDIR /app/saga-sm
RUN pnpm install --prod --no-frozen-lockfile

# Copy built application and generated Prisma client
COPY --from=builder --chown=apiuser:nodejs /app/saga-sm/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=apiuser:nodejs /app/saga-sm/packages/database/generated ./packages/database/generated
COPY --from=builder --chown=apiuser:nodejs /app/saga-sm/packages/database/dist ./packages/database/dist

# Switch to non-root user
USER apiuser

# Set working directory
WORKDIR /app/saga-sm/apps/api

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Start application
CMD ["node", "dist/main.js"]
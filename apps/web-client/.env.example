# Web Client Environment Configuration
# Copy this file to .env.local for Next.js local development

# Server Configuration
NODE_ENV=development
PORT=3001

# API Connection (public - accessible in browser)
# These variables must start with NEXT_PUBLIC_ to be available in the browser
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_TRPC_URL=http://localhost:3000/trpc

# Alternative variable names for compatibility
# NEXT_PUBLIC_SAGA_SM_API_URL=http://localhost:3000
# NEXT_PUBLIC_TRPC_BASE_PATH=/trpc
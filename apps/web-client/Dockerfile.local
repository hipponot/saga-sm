# Dockerfile for local development with saga-soa file: dependencies
# Build context should be run from the dev directory (parent of saga-sm and saga-soa)
# Usage: docker build -f saga-sm/apps/web-client/Dockerfile.local -t saga-sm-web-client:local .

# Dependencies stage - for better layer caching
FROM node:18-alpine AS dependencies

WORKDIR /app

# Install pnpm (matching the version used in the project)
RUN npm install -g pnpm@8.15.4

# Copy saga-soa packages first (external dependencies)
COPY saga-soa/ ./saga-soa/

# Copy saga-sm workspace configuration
COPY saga-sm/pnpm-workspace.yaml saga-sm/package.json saga-sm/turbo.json ./saga-sm/

# Copy saga-sm package files for dependency resolution
COPY saga-sm/apps/api/types/package.json ./saga-sm/apps/api/types/
COPY saga-sm/apps/web-client/package.json ./saga-sm/apps/web-client/
COPY saga-sm/packages/ ./saga-sm/packages/

# Install dependencies (file: references will work because saga-soa is copied)
WORKDIR /app/saga-sm
RUN pnpm install --no-frozen-lockfile

# Build saga-soa packages first
WORKDIR /app/saga-soa
RUN pnpm build

# Build stage
FROM dependencies AS builder

WORKDIR /app/saga-sm

# First copy and build API types (dependency for web-client)
COPY saga-sm/apps/api/types/src/ ./apps/api/types/src/
COPY saga-sm/apps/api/types/tsconfig.json saga-sm/apps/api/types/tsup.config.ts saga-sm/apps/api/types/codegen.config.js ./apps/api/types/

# Build API types first
RUN cd apps/api/types && pnpm build && cd ../..

# Copy web client source code
COPY saga-sm/apps/web-client/app/ ./apps/web-client/app/
COPY saga-sm/apps/web-client/src/ ./apps/web-client/src/
COPY saga-sm/apps/web-client/*.json ./apps/web-client/
COPY saga-sm/apps/web-client/*.ts ./apps/web-client/
COPY saga-sm/apps/web-client/eslint.config.mjs ./apps/web-client/
COPY saga-sm/apps/web-client/next.config.js ./apps/web-client/

# Set Docker environment variable to indicate containerized deployment
ENV DOCKER_ENV=true

# Use turbo to build with optimized dependency resolution
RUN npx turbo build --filter=@saga-sm/web-client

# Production stage
FROM node:18-alpine AS production

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextuser -u 1001 -G nodejs

# Install pnpm and serve
RUN npm install -g pnpm@8.15.4 serve@14.2.3

# Copy saga-soa packages and built artifacts
COPY --from=builder /app/saga-soa/ ./saga-soa/

# Copy saga-sm workspace files for production install
COPY --from=builder /app/saga-sm/pnpm-workspace.yaml /app/saga-sm/package.json ./saga-sm/
COPY --from=builder /app/saga-sm/packages/ ./saga-sm/packages/
COPY --from=builder /app/saga-sm/apps/api/types/package.json ./saga-sm/apps/api/types/
COPY --from=builder /app/saga-sm/apps/web-client/package.json ./saga-sm/apps/web-client/

# Install production dependencies only
WORKDIR /app/saga-sm
RUN pnpm install --prod --no-frozen-lockfile

# Copy built static application and API types with correct ownership
COPY --from=builder --chown=nextuser:nodejs /app/saga-sm/apps/web-client/out ./apps/web-client/out
COPY --from=builder --chown=nextuser:nodejs /app/saga-sm/apps/web-client/next.config.js ./apps/web-client/
COPY --from=builder --chown=nextuser:nodejs /app/saga-sm/apps/api/types/dist ./apps/api/types/dist

# Set Docker environment variable to indicate containerized deployment
ENV DOCKER_ENV=true

# Switch to non-root user
USER nextuser

# Set working directory to web client
WORKDIR /app/saga-sm/apps/web-client

# Expose port
EXPOSE 3001

# Start the application
CMD ["pnpm", "start"]